# Ambiente virtual: cada um cria o seu (veja COMO RODAR no topo do main.py)
.venv/
venv/

# Bytecode que o Python gera ao rodar o jogo
__pycache__/
*.py[cod]

# Recordes do jogador: o jogo cria e grava sozinho (jogo/save.py)
savegame.json
savegame.json.tmp

# macOS
.DS_Store
._*

# Sobras da tentativa de recuperar a versao antiga do jogo a partir dos .pyc
/*_dis.txt
/*_decompiled.py
/scratch.py

# Pasta de configuracao do Claude criada por engano com um "~" literal (tem credenciais)
/~/

# Videos renderizados (o trailer tem mais de 100 MB, acima do limite do GitHub):
# vao para o YouTube/itch.io, nao para o repositorio
*.mp4

# Faixas originais e versoes longas, guardadas so para refazer as edicoes
# (ferramentas/geradores/editar_musica.py); o jogo usa as de assets/music
ferramentas/musica_fonte/
